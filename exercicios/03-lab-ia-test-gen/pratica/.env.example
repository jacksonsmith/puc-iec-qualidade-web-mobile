# Copie pra .env e preencha. Custo pro aluno: ZERO — use o preset GitHub Models.

# ── Preset 1 (DEFAULT, GRÁTIS): GitHub Models ────────────────────────────────
# Você já tem conta GitHub (forkou este repo). Gere um token:
#   GitHub → Settings → Developer settings → Fine-grained tokens → Generate new
#   → em "Account permissions", marque só "Models: Read" → Generate
# Free tier = limite DIÁRIO de requisições (o lab usa poucas — planeje as rodadas).
LLM_API_KEY=github_pat_...
# LLM_BASE_URL=https://models.github.ai/inference   (default — pode omitir)
# LLM_MODEL=openai/gpt-4o-mini                      (default — pode omitir)

# ── Preset 2 (GRÁTIS, offline): Ollama local ─────────────────────────────────
# ollama pull qwen2.5-coder:7b  (precisa de ~8GB RAM)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:7b
# LLM_API_KEY=ollama

# ── Preset 3 (PAGO, opcional): Anthropic/Claude ──────────────────────────────
# É o que o professor usa na demonstração do screencast (qualidade superior).
# NÃO é exigido em nenhum critério do lab.
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-opus-4-8
# LLM_API_KEY=sk-ant-...
